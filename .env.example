# Supabase (Google login in browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use either name (Supabase dashboard may show "publishable" or "anon")
VITE_SUPABASE_ANON_KEY=your_anon_public_key
# VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Optional: override API URL (default uses Vite proxy to localhost:3001).
# On Vercel/Netlify leave unset so /api hits the same deployment.
# VITE_API_URL=http://127.0.0.1:3001

# Must match server SUPER_ADMIN_EMAIL (Clan Master Google account)
# VITE_SUPER_ADMIN_EMAIL=roypouomogne@gmail.com
