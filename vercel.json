{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --prefix server && npm run build:web",
  "installCommand": "npm install && npm install --prefix server",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/((?!health$).*)",
      "destination": "/api"
    },
    { "source": "/((?!api/|assets/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
